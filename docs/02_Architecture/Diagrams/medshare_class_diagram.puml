@startuml
!theme vibrant
title MedShare Class Diagram: Final Combined Accuracy

' --- Python ML Engine Components ---
package "medshare/models.py" {
    class SurvivalMLP {
        +input_dim: int
        +num_classes: int
        +fc: Sequential
        +forward(x: Tensor) : Tensor
    }
}

package "medshare/client.py" {
    class FlowerSurvivalClient {
        -net: SurvivalMLP
        -trainloader: DataLoader
        -valloader: DataLoader
        -privacy_engine: PrivacyEngine
        -blockchain: MedShareBlockchain
        +get_parameters(config) : List[np.array]
        +fit(parameters, config) : Tuple
        +evaluate(parameters, config) : Tuple
    }
}

package "medshare/strategy.py" {
    class AnomalyMonitoringStrategy {
        +latest_weights: List[np.array]
        +aggregate_fit(server_round, results, failures) : Tuple
        -check_audit_norms(results) : void
    }
    class WeightCaptureWrapper {
        +base_strategy: Strategy
        +latest_weights: List[np.array]
        +aggregate_fit(server_round, results, failures)
    }
}

package "medshare/blockchain.py" {
    class MedShareBlockchain {
        +w3: Web3
        +task_contract: Contract
        +registry_contract: Contract
        +reputation_contract: Contract
        +post_commitment(task_id, round, weights, client_id) : int
        +post_final_model(task_id, weights) : int
        +authorize_hospital(hospital_idx) : void
        +update_reputation(hospital_idx, change, reason) : void
        -hash_weights(weights) : bytes32
    }
}

' --- Solidity Components ---
package "Smart Contracts" {
    struct Task {
        +address researcher
        +uint256 bounty
        +string modelDescription
        +uint256 minClients
        +uint256 rounds
        +TaskStatus status
        +address[] hospitals
    }
    
    class MedShareTask {
        +tasks: mapping(uint256 => Task)
        +taskCount: uint256
        +admin: address
        +createTask(description, minClients, rounds) : void
        +joinTask(taskId) : void
        +completeTask(taskId, finalModelHash) : void
        +authorizeHospital(hospital, status) : void
    }

    class CommitmentRegistry {
        +commitments: mapping
        +finalModelWeights: mapping
        +isAuthorized: mapping(address => bool)
        +postCommitment(taskId, round, hash) : void
        +postFinalWeights(taskId, hash) : void
        <<event>> CommitmentPosted(taskId, round, hash)
    }

    class Reputation {
        +scores: mapping(address => int256)
        +updateReputation(hospital, change, reason) : void
        +getScore(hospital) : int256
    }
    
    interface IReputation {
        +getScore(address) : int256
    }
}

' --- Relationships & Inheritance ---
FlowerSurvivalClient --|> flwr.client.NumPyClient : "Inherits"
AnomalyMonitoringStrategy --|> flwr.server.strategy.FedAvg : "Inherits"

FlowerSurvivalClient --> SurvivalMLP : "Trains"
FlowerSurvivalClient --> MedShareBlockchain : "Logs Proof"
AnomalyMonitoringStrategy --> MedShareBlockchain : "Logs Final Result"
WeightCaptureWrapper --> AnomalyMonitoringStrategy : "Wraps"
MedShareBlockchain --> CommitmentRegistry : "Calls (RPC)"
MedShareBlockchain --> MedShareTask : "Calls (RPC)"
MedShareBlockchain --> Reputation : "Calls (RPC)"
MedShareTask ..> Task : "Stores"
MedShareTask ..> IReputation : "Checks Authorization"
@enduml