@startuml
!theme vibrant
title MedShare Sequence: Secure Federated Execution

actor "Hospital Node" as NODE
participant "Flower Client" as CLIENT
participant "Training Engine" as ENGINE
participant "PyTorch Model" as MODEL
participant "Opacus Engine" as PRIVACY
participant "MedShareBlockchain" as BCM
participant "Reputation.sol" as REP
participant "MedShareTask.sol" as TASK
participant "CommitmentRegistry.sol" as REG
participant "Flower ServerApp" as SERVER
participant "AnomalyMonitoringStrategy" as STRAT

== Initialization & Gatekeeping ==
SERVER -> BCM : 1. Verify Node Reputation
BCM -> REP : getScore(node_address)
REP --> BCM : Return Score (e.g., 100)
BCM --> SERVER : node_authorized = (Score >= 0)

SERVER -> TASK : 2. createTask (Lock ETH Bounty)
NODE -> TASK : joinTask (Register for FL)

== Training Round (Loop) ==
SERVER -> CLIENT : 3. fit(global_weights)
activate CLIENT

CLIENT -> MODEL : set_parameters(global_weights)
CLIENT -> ENGINE : train(model, data)
ENGINE -> MODEL : Forward Pass (net(images))
ENGINE -> PRIVACY : DP-SGD (Gradient Clipping & Noise)
ENGINE -> MODEL : Update Weights (Backprop + FedProx Penalty)

CLIENT -> BCM : 4. Hash Weights & Log Audit
activate BCM
BCM -> REG : postCommitment(taskId, round, hash)
REG --> BCM : Receipt (Gas Used)
BCM --> CLIENT : gas_used
deactivate BCM

CLIENT -> CLIENT : 5. SecAgg Cryptography (Mask Weights)
CLIENT --> SERVER : 6. Return (Masked Weights, metrics(gas_used, epsilon))
deactivate CLIENT

== Aggregation Phase ==
SERVER -> STRAT : 7. aggregate_fit(results)
activate STRAT

STRAT -> STRAT : Robust-MAD Defense (Filter outliers)

alt if node is malicious (outlier)
    STRAT -> BCM : 8. Slash Reputation
    BCM -> REP : updateReputation(node, -10)
else if node is honest
    STRAT -> BCM : Reward Reputation
    BCM -> REP : updateReputation(node, +1)
end

STRAT -> BCM : 9. Record Global Proof
BCM -> REG : postFinalWeights(taskId, global_hash)
STRAT --> SERVER : Final Aggregated Model (FedAvg)
deactivate STRAT

== Evaluation & Cleanup ==
SERVER -> CLIENT : 10. evaluate(global_model)
CLIENT -> MODEL : Calculate Accuracy/AUC
CLIENT --> SERVER : Accuracy Metric

alt final round complete
    SERVER -> TASK : 11. completeTask(taskId, hash)
    TASK -> REP : Query Honest Score
    TASK -> TASK : Release Bounty to Honest Nodes
end

@enduml