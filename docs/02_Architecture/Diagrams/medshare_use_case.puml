@startuml
!theme vibrant
title MedShare Use Cases: Requirements Map

left to right direction
actor "Medical Researcher" as RESEARCHER
actor "Hospital Node" as HOSPITAL
actor "Adversarial Hospital" as ADVERSARY
actor "System Administrator" as ADMIN
actor "Public Auditor" as AUDITOR

HOSPITAL <|-- ADVERSARY : "Threat Model"

rectangle "MedShare Platform" {
    package "FL Management" {
        usecase "Initialize FL Study" as U1
        usecase "Join Study and Register" as U2
        usecase "Visualize Performance" as VIZ
        usecase "Download Aggregated Model" as DOWN
    }
    
    package "Privacy & Defense" {
        usecase "Train locally (DP + FedProx)" as U3
        usecase "Mask Weights (SecAgg)" as SECAGG
        usecase "Filter Outliers (Robust-MAD)" as U4
        usecase "Inject Poisoned Gradient" as POISON
    }
    
    package "Blockchain & Logistics" {
        usecase "Post Audit Commitment (Hash)" as U5
        usecase "Verify Immutable Audit Trail" as U6
        usecase "Authorize Node via Reputation" as U7
        usecase "Withdraw Study Bounty (ETH)" as U8
    }
}

' Researcher Flow
RESEARCHER --> U1
RESEARCHER --> VIZ
RESEARCHER --> DOWN

' Hospital Flow
HOSPITAL --> U2
HOSPITAL --> U3
HOSPITAL --> SECAGG
HOSPITAL --> U5
HOSPITAL --> U8

' Malicious variation
ADVERSARY --> POISON
U4 ..> POISON : "<<includes>>\nDetect & Slash Reputation"

' Admin Flow
ADMIN --> U7
U7 ..> U2 : "<<precondition>>"

' Auditor Flow
AUDITOR --> U6
U6 ..> U5 : "<<verifies>>\nCheck Gas & Hashes"

note top of U8
  Bounty logic defined in
  MedShareTask.sol
end note

note bottom of U7
  Reputation logic defined in
  Reputation.sol
end note

@enduml